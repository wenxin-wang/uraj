#!/usr/bin/env bash
# Run on a Docker build host: sudo ./build-get-receipt /path/to/openclaw-source
set -euo pipefail

if [[ $# != 1 ]]; then
  echo "Usage: $0 /path/to/openclaw-source" >&2
  exit 2
fi
source_dir=$(cd "$1" && pwd)
recipe_dir=$(cd "$(dirname "$0")" && pwd)
expected_commit=59cb44796b0f1f0daa0e37af8b1495abb45d9bc1
if [[ $(git -c safe.directory="$source_dir" -C "$source_dir" rev-parse HEAD) != "$expected_commit" ]]; then
  echo "Expected OpenClaw v2026.10.3 commit $expected_commit" >&2
  exit 1
fi

# Export committed sources: leave the supplied checkout and its changes intact.
build_dir=$(mktemp -d)
trap 'rm -rf -- "$build_dir"' EXIT
git -c safe.directory="$source_dir" -C "$source_dir" archive HEAD | tar -x -C "$build_dir"
git -C "$build_dir" apply --check "$recipe_dir/patches/feishu-get-receipt.patch"
git -C "$build_dir" apply "$recipe_dir/patches/feishu-get-receipt.patch"
docker build --network=host --pull=false \
  --build-arg OPENCLAW_EXTENSIONS=feishu \
  -t localhost/openclaw-feishu:2026.10.3-get-source "$build_dir"
# Keep the SDK resolution repair used by the deployed image.
docker build --network=host --pull=false \
  --build-arg BASE_IMAGE=localhost/openclaw-feishu:2026.10.3-get-source \
  -t localhost/openclaw-feishu:2026.10.3-get1 "$recipe_dir"
docker run --rm --network none --read-only --user 1000:1000 \
  --workdir /app/dist --entrypoint node \
  localhost/openclaw-feishu:2026.10.3-get1 \
  --input-type=module -e 'await import("@larksuiteoapi/node-sdk")'
docker image inspect --format '{{.Id}}' localhost/openclaw-feishu:2026.10.3-get1
