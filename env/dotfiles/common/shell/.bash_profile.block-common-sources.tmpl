if [ ! -n "$HAS_MY_PROFILE" ]; then
    [[ -f ~/.profile ]] && . ~/.profile
    for dir in ~/.profile.d; do
        if [ -d $dir ]
        then
            for profile in $dir/*.sh
            do
                . $profile
            done
        fi
    done
    # Export before sourcing ~/.bashrc: the same guard there must not load
    # the profile a second time.
    export HAS_MY_PROFILE=1
fi
[[ -f ~/.bashrc ]] && . ~/.bashrc
