#!/bin/sh
# Launch Feishu with native Wayland and IME support.
#
# No --force-device-scale-factor: Chromium follows each output's integer
# wl_output scale on its own (2 for the 1.5x panel, 1 for the 1.0x monitor),
# so text rasterizes at or above the physical scale and stays sharp on either
# screen.
#
# WaylandFractionalScaleV1 is disabled because with it Chromium computes
# surface/input geometry at the wrong scale under niri, and clicks land beside
# the rendered widgets on the 1.5x panel (niri issue #2770). Without it
# Chromium uses wp_viewport with integer buffer scales instead, which keeps
# input aligned.

set -u

FEISHU=/usr/bin/bytedance-feishu-stable

if [ -e /etc/os-release ]; then
    . /etc/os-release
fi

flags=""
if [ -n "${WAYLAND_DISPLAY:-}" ] && [ "$NAME" = "Ubuntu" ] && \
        [ "$(echo "$VERSION_ID > 22.04" | bc -l )" = 1 ] ; then
    flags="--ozone-platform=wayland --disable-features=WaylandFractionalScaleV1 --enable-wayland-ime --wayland-text-input-version=3"
fi

# shellcheck disable=SC2086
exec "$FEISHU" $flags "$@"
