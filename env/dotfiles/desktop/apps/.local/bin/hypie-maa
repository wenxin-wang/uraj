#!/usr/bin/env bash
# Operate hypie's redroid-maa Android from this desktop.
#
# ADB listens only on hypie's private redroid bridge (10.203.0.2:5555, see
# docs/maa.org), so every command runs through a short-lived SSH forward to
# 127.0.0.1:$HYPIE_MAA_PORT here; the forward is torn down when it finishes.
# A forward left by another running hypie-maa is reused.

set -euo pipefail

host=${HYPIE_MAA_HOST:-hypie.home.labbies.wenxinwang.me}
port=${HYPIE_MAA_PORT:-15555}
remote=10.203.0.2:5555
serial=127.0.0.1:$port
package=com.hypergryph.arknights
# Official server's "latest Android client" link on ak.hypergryph.com.
apk_url=${HYPIE_MAA_APK_URL:-https://ak.hypergryph.com/downloads/android_lastest}
cache=${XDG_CACHE_HOME:-$HOME/.cache}/hypie-maa

usage() {
    cat <<EOF
Usage: hypie-maa COMMAND [ARGS...]

  screen [SCRCPY-ARGS]  Show and control Android (scrcpy), e.g. to log in.
  login                 Same as screen.
  install APK           Install or update the game from a local APK.
  upgrade               Download the official latest APK, then install it.
  status                Android boot state and installed game version.
  adb ARGS...           Run adb against the instance.
  connect               Keep the forward open for other tools (Ctrl-C ends).

Environment: HYPIE_MAA_HOST ($host), HYPIE_MAA_PORT ($port),
HYPIE_MAA_APK_URL.
EOF
}

# adb and scrcpy come from the desktop home profile ((uraj home basic-desktop)).
for tool in adb scrcpy curl ssh; do
    if ! command -v "$tool" >/dev/null; then
        printf 'hypie-maa: %s not found in PATH\n' "$tool" >&2
        exit 127
    fi
done
# scrcpy embeds Guix's adb, whose server crashes; use the one in PATH
# (android-platform-tools) so both talk to the same server.
export ADB=${ADB:-$(command -v adb)}

say() { printf 'hypie-maa: %s\n' "$*" >&2; }

ctl=
cleanup() {
    adb disconnect "$serial" >/dev/null 2>&1 || true
    if [[ -n $ctl ]]; then
        ssh -S "$ctl" -O exit "$host" >/dev/null 2>&1 || true
        rm -rf -- "$(dirname -- "$ctl")"
    fi
}

open_forward() {
    adb start-server >/dev/null
    if adb connect "$serial" 2>/dev/null | grep -qE '^(already )?connected' &&
        [[ $(adb -s "$serial" get-state 2>/dev/null) == device ]]; then
        return # another hypie-maa already forwards this port
    fi
    adb disconnect "$serial" >/dev/null 2>&1 || true
    ctl=$(mktemp -d)/ctl
    trap cleanup EXIT
    say "forwarding $serial to $host:$remote over SSH"
    ssh -f -N -M -S "$ctl" -o ExitOnForwardFailure=yes \
        -L "127.0.0.1:$port:$remote" "$host"
    local i
    for i in 1 2 3 4 5; do
        adb connect "$serial" 2>/dev/null | grep -qE '^(already )?connected' && break
        sleep 1
    done
    # wait-for-device would block forever on an unauthorized/offline device.
    if ! timeout 30 adb -s "$serial" wait-for-device; then
        say "device not ready after 30s:"
        adb devices -l >&2
        exit 1
    fi
}

game_version() {
    adb -s "$serial" shell dumpsys package "$package" |
        sed -n '/^ *versionName=/{s///p;q}'
}

install_apk() {
    local apk=$1 before after
    before=$(game_version)
    say "installing $apk ($(du -h -- "$apk" | cut -f1)); this can take minutes"
    adb -s "$serial" install -r "$apk"
    after=$(game_version)
    printf 'game version: %s -> %s\n' "${before:-none}" "${after:-none}"
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift
case $cmd in
    screen | login)
        open_forward
        # redroid has no opus encoder, and audio capture aborts the server.
        scrcpy -s "$serial" --window-title "hypie redroid-maa" --no-audio "$@"
        ;;
    install)
        [[ $# -eq 1 && -f $1 ]] || { usage >&2; exit 2; }
        open_forward
        install_apk "$1"
        ;;
    upgrade)
        mkdir -p -- "$cache"
        say "downloading $apk_url"
        curl -fL --retry 3 -o "$cache/arknights.apk.part" "$apk_url"
        # An HTML error page is not an APK: require the ZIP signature.
        if [[ $(head -c 2 "$cache/arknights.apk.part") != PK ]]; then
            printf 'hypie-maa: %s did not return an APK\n' "$apk_url" >&2
            exit 1
        fi
        mv -- "$cache/arknights.apk.part" "$cache/arknights.apk"
        open_forward
        install_apk "$cache/arknights.apk"
        ;;
    status)
        open_forward
        printf 'boot completed: %s\n' \
            "$(adb -s "$serial" shell getprop sys.boot_completed)"
        printf 'game version: %s\n' "$(game_version || true)"
        ;;
    adb)
        open_forward
        adb -s "$serial" "$@"
        ;;
    connect)
        open_forward
        printf 'adb serial %s; Ctrl-C to close\n' "$serial"
        while sleep 3600; do :; done
        ;;
    -h | --help | help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
