// Niri configuration with Noctalia (v5) integration.
// Reference: https://yalter.github.io/niri/Configuration:-Introduction

input {
    keyboard {
        xkb {
            // Empty: niri fetches xkb settings from org.freedesktop.locale1.
            // Use `localectl set-x11-keymap` to change layouts.
        }

        repeat-delay 300
        repeat-rate 30
    }

    touchpad {
        tap
        dwt
        natural-scroll
    }

    // warp-mouse-to-focus
}

// Settings that influence how windows are positioned and sized.
layout {
    gaps 8

    focus-ring {
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        off
    }

    // Brighter, chunkier tab indicator: explicit colors (the defaults fall
    // back to the focus ring's #505050 for inactive tabs, which halves to
    // near-invisible when the column isn't focused).
    tab-indicator {
        hide-when-single-tab
        width 8
        length total-proportion=1.0
        gaps-between-tabs 2
        corner-radius 4
        active-color "#7fc8ff"
        inactive-color "#606060"
        urgent-color "#ff5555"
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }
}

// Set variables for applications spawned by niri.
environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    // X11 apps run on Xwayland :1, which the session Shepherd keeps up
    // (see (uraj packages window-managers)).  This covers niri's direct
    // spawns -- terminals and their children; apps launched via noctalia
    // inherit shepherd's env instead.
    DISPLAY ":1"
    // Qt apps need this to find qtwayland's platform plugin
    // and run as native Wayland clients; without it they fall back to X11.
    QT_PLUGIN_PATH "/home/wenxin/.guix-home/profile/lib/qt6/plugins"
}

// The HP monitor is the external display that the built-in panels below
// are placed relative to; it is focused at startup (niri opens new
// windows on the focused output).  Positions are in logical pixels.
output "HP Inc. HP P27q G4 CNC0441QRP" {
    position x=0 y=0
    focus-at-startup
}

// Same as above.
output "Philips Consumer Electronics Company PHL 245E1 0x00000693" {
    position x=0 y=0
    focus-at-startup
}

// 3840x2160 at scale 1.5 gives 2560x1440 logical pixels.
output "Philips Consumer Electronics Company PHL 279C9 UHB2247016586" {
    position x=0 y=0
    scale 1.5
    focus-at-startup
}

// Built-in panel of the Lenovo Legion Y7000 IRX10: 2560x1600 at scale 1.5,
// i.e. 1706x1066 logical, so to the right of the 2560x1440 HP its
// position is x = 2560, y = (1440 - 1066) / 2 = 187.
output "China Star Optoelectronics Technology Co., Ltd MNF307DA1-1 0x00005302" {
    position x=2560 y=187
    scale 1.5
}

// GNOME ran this panel at 125% (see ~/.config/monitors.xml); niri's
// auto-detected 1.5 made everything larger than before. Keep in sync with
// env/dotfiles/common/x11/Xresources (Xft.dpi = 96 x scale).
// 2240x1400 at scale 1.25, i.e. 1792x1120, so below the 2560x1440 HP its
// position is x = (2560 - 1792) / 2 = 384, y = 1440.
output "AU Optronics 0xA195 Unknown" {
    position x=384 y=1440
    scale 1.25
}

// Center the 1645x1028 logical panel below the 2560x1440 external display.
output "Samsung Display Corp. ATNA40HQ05-0  Unknown" {
    position x=458 y=1440
    scale 1.75
}

// Start user Shepherd for Guix Home; noctalia, fcitx5, the portals,
// Xwayland and the display targets are its services.
spawn-at-startup "shepherd"

// Load ~/.Xresources once Xwayland (xwayland-satellite) is up: satellite
// reports the real physical size (~190 DPI) to Xwayland, which makes X11
// apps (Feishu, emacs, ...) render far larger than under GNOME. Xft.dpi
// brings them back to 96 x scale = 120 DPI.
spawn-at-startup "sh" "-c" "while ! xrdb -merge ~/.Xresources 2>/dev/null; do sleep 1; done"

// Xwayland is provided by the session Shepherd on :1 (see (uraj packages
// window-managers)).  niri's own spawner starts xwayland-satellite on
// demand -- on the first X client connection -- which is too late for
// fcitx5's XIM frontend: it connects to X at startup and does not retry,
// so X must be up before the graphical-session services start.  Keep
// exactly one X server: the Shepherd's.
xwayland-satellite {
    off
}

hotkey-overlay {
    skip-at-startup
}

// Ask clients to omit their client-side decorations.
prefer-no-csd

screenshot-path "~/tmp/Pictures/Screenshots/%Y%m%d-%H%M%S.png"

// Noctalia: rounded corners for all windows.
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// The Satty annotation window floats above the tiled layout.
window-rule {
    match app-id=r#"^org\.satty\.satty$"#
    open-floating true
    geometry-corner-radius 0
    clip-to-geometry false
}

debug {
    honor-xdg-activation-with-invalid-serial
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Applications.
    Mod+Return { spawn "ghostty"; }

    // Noctalia.
    Mod+Z            { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+D            { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Shift+Ctrl+S { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Shift+Q      { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Ctrl+Q       { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Shift+E      { spawn "herd" "restart" "noctalia"; }

    // Volume and media keys.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute         allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
    XF86AudioPlay         allow-when-locked=true { spawn "noctalia" "msg" "media" "playPause"; }
    XF86AudioStop         allow-when-locked=true { spawn "noctalia" "msg" "media" "pause"; }
    XF86AudioPrev         allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioNext         allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    // Windows and workspaces.
    Mod+Q repeat=false { close-window; }
    Mod+A repeat=false { toggle-overview; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }

    Mod+Ctrl+Shift+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Down  { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+Up    { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+H     { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+J     { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+K     { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+L     { move-column-to-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+O              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Shift+O         { move-column-to-workspace-down; }
    Mod+Shift+I         { move-column-to-workspace-up; }

    Mod+Ctrl+Page_Down { move-workspace-down; }
    Mod+Ctrl+Page_Up   { move-workspace-up; }
    Mod+Ctrl+O         { move-workspace-down; }
    Mod+Ctrl+I         { move-workspace-up; }

    Mod+WheelScrollDown       cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp         cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown  cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp    cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { focus-column-left; }
    Mod+Shift+Ctrl+WheelScrollRight cooldown-ms=150 { move-column-right; }
    Mod+Shift+Ctrl+WheelScrollLeft  cooldown-ms=150 { move-column-left; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }
    Mod+Shift+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V       { toggle-window-floating; }
    Mod+Ctrl+V { switch-focus-between-floating-and-tiling; }

    Mod+T { toggle-column-tabbed-display; }

    // niri captures; Satty annotates. Ctrl+S saves, Ctrl+C copies.
    // Laptop screenshot key emits Super+Ctrl+S rather than Print.
    Mod+S       { spawn "python3" "/home/wenxin/.config/niri/screenshot.py" "region"; }
    Print       { spawn "python3" "/home/wenxin/.config/niri/screenshot.py" "region"; }
    Mod+Shift+S { spawn "python3" "/home/wenxin/.config/niri/screenshot.py" "screen"; }
    Shift+Print { spawn "python3" "/home/wenxin/.config/niri/screenshot.py" "screen"; }
    Mod+Ctrl+S  { spawn "python3" "/home/wenxin/.config/niri/screenshot.py" "window"; }
    Ctrl+Print  { spawn "python3" "/home/wenxin/.config/niri/screenshot.py" "window"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+P { power-off-monitors; }
}
