#!/bin/sh
# Run on storie as the administrator.  Start the sandbox image with the
# hardening OpenClaw's sandbox applies, then check headless Vulkan browsers.
# Usage: try-sandbox-image IMAGE [NETWORK] [DNS]
set -eu

image=${1:?usage: try-sandbox-image IMAGE [NETWORK] [DNS]}
network=${2:-sandboxed-agents}
dns=${3:-}
workspace=$(mktemp -d /var/tmp/openclaw-sandbox-image.XXXXXX)
echo "workspace: $workspace"

run() {
  docker run --rm --network "$network" ${dns:+--dns "$dns"} \
    --device /dev/dri/renderD128 \
    --read-only --tmpfs /tmp --tmpfs /var/tmp --tmpfs /run \
    --cap-drop ALL --security-opt no-new-privileges \
    --user "$(id -u):$(id -g)" --shm-size 64m \
    --mount "type=bind,source=$workspace,target=/workspace" \
    "$image" sh -euc "$1"
}

run '
echo "== file bridge tools"
stat -c "%F|%s|%y" /workspace
readlink -n -f /workspace; echo
python3 -c "print(\"python3 ok\")"
python -c "print(\"python ok\")"
node -e "console.log(\"node ok\")"
echo "== agent-browser"
agent-browser --version
agent-browser skills get core > /tmp/core.md
head -n 3 /tmp/core.md
'

run '
browser-profile login https://example.com
browser-profile identity eval "localStorage.setItem(\"profile-smoke\", \"persisted\")"
browser-profile publish
first=$(browser-profile create | jq -r .task)
second=$(browser-profile create | jq -r .task)
ab() { browser-profile run "$first" "$@"; }
browser-profile run "$second" open about:blank
ab open https://example.com
ab get title
ab eval "localStorage.getItem(\"profile-smoke\")" > /tmp/profile-value
grep -q persisted /tmp/profile-value
ab eval "navigator.userAgent"
ab eval "navigator.webdriver"
ab eval "(() => { const gl = document.createElement(\"canvas\").getContext(\"webgl\");
  const ext = gl && gl.getExtension(\"WEBGL_debug_renderer_info\");
  return ext ? gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) : String(gl); })()" > /tmp/renderer
cat /tmp/renderer
grep -Eiq "Intel|AMD|NVIDIA" /tmp/renderer
if grep -Eiq "SwiftShader|llvmpipe|lavapipe" /tmp/renderer; then
  echo "software renderer rejected" >&2
  exit 1
fi
ab screenshot /workspace/gpu-smoke.png
test -s /workspace/gpu-smoke.png
browser-profile finish "$first"
browser-profile finish "$second"
test -d /workspace/.agent-browser/current && echo "snapshot persisted"
'
echo "done; remove $workspace when finished"
