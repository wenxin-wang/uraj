#!/bin/sh
# Use the installed CLI to generate an identity config without changing it live.
set -eu

/etc/openclaw/compose exec -T gateway node --input-type=module <<'JS'
import { copyFile, mkdtemp, readFile, rm } from "node:fs/promises";
import { spawnSync } from "node:child_process";

const directory = await mkdtemp("/tmp/openclaw-identity-");
const path = `${directory}/openclaw.json`;
try {
  await copyFile("/etc/openclaw/openclaw.json", path);
  const env = { ...process.env, OPENCLAW_CONFIG_PATH: path };
  delete env.OPENCLAW_CONFIG_READONLY;
  const result = spawnSync(process.execPath, [
    "/app/openclaw.mjs", "agents", "set-identity",
    "--workspace", "/workspace", "--from-identity",
  ], { env, stdio: ["ignore", "inherit", "inherit"] });
  if (result.error || result.status !== 0) {
    process.exitCode = 1;
  } else {
    const config = JSON.parse(await readFile(path, "utf8"));
    const agents = config.agents ?? {};
    // Preserve the installed version's schema, but print only identity fields.
    const output = {};
    if (agents.list) {
      output.list = agents.list.map(({ id, identity }) => ({ id, identity }));
    }
    if (agents.entries) {
      output.entries = Object.fromEntries(Object.entries(agents.entries)
        .map(([id, agent]) => [id, { identity: agent.identity }]));
    }
    console.log(JSON.stringify({ agents: output }, null, 2));
  }
} finally {
  await rm(directory, { recursive: true, force: true });
}
JS
