if has guix; then
    watch_file env/guix/channels-lock.scm env/guix/manifest.scm
    eval "$(guix time-machine -C env/guix/channels-lock.scm -- shell -m env/guix/manifest.scm --search-paths)"

    # Expose the lock-pinned guix modules to ambient guile processes
    # (maak, geiser, ...), which do NOT go through `guix time-machine`.
    # Must come after the shell eval above: on cold cache that line builds
    # the pinned profile, so this lookup is guaranteed a cheap cache hit.
    tm="$(guix time-machine -C env/guix/channels-lock.scm | tail -n1)"
    if [ -d "$tm/share/guile/site/3.0" ]; then
        export GUILE_LOAD_PATH="$tm/share/guile/site/3.0${GUILE_LOAD_PATH:+:$GUILE_LOAD_PATH}"
        export GUILE_LOAD_COMPILED_PATH="$tm/lib/guile/3.0/site-ccache${GUILE_LOAD_COMPILED_PATH:+:$GUILE_LOAD_COMPILED_PATH}"
    fi
fi
export GUILE_LOAD_PATH="$PWD/src/guile${GUILE_LOAD_PATH:+:$GUILE_LOAD_PATH}"
